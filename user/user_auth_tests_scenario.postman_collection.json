    {
      "name": "5. Update User 1 profile",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const newName = `UpdatedUser_${Date.now()}`;",
              "const newEmail = `updated_${Date.now()}@test.com`;",
              "pm.collectionVariables.set('user1_new_name', newName);",
              "pm.collectionVariables.set('user1_new_email', newEmail);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const jsonData = pm.response.json();",
              "pm.test('Profile updated correctly', () => {",
              "    pm.expect(jsonData.name).to.eql(pm.collectionVariables.get('user1_new_name'));",
              "    pm.expect(jsonData.email).to.eql(pm.collectionVariables.get('user1_new_email'));",
              "});",
              "",
              "// Сохраняем обновлённые данные (токен пока остаётся старым – он станет недействителен)",
              "pm.collectionVariables.set('user1_email', jsonData.email);",
              "pm.collectionVariables.set('user1_name', jsonData.name);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{user1_token}}"
          },
