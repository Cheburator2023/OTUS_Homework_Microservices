          "raw": "{\n    \"name\": \"{{user1_new_name}}\",\n    \"email\": \"{{user1_new_email}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/profile",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "profile"]
        }
      }
