    {
      "name": "10. User 2 accesses own profile (should not see user1 data)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 (user2 gets own profile)', () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const jsonData = pm.response.json();",
              "pm.test('User2 sees their own profile, not user1', () => {",
              "    pm.expect(jsonData.email).to.eql(pm.collectionVariables.get('user2_email'));",
              "    pm.expect(jsonData.name).to.eql(pm.collectionVariables.get('user2_name'));",
              "    pm.expect(jsonData.email).to.not.eql(pm.collectionVariables.get('user1_email'));",
              "    pm.expect(jsonData.name).to.not.eql(pm.collectionVariables.get('user1_name'));",
              "});"
            ],
